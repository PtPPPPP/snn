SNN_AI_NODE_HOST=127.0.0.1
SNN_AI_NODE_PORT=8787
# Production MUST include the real browser origin, e.g. https://snnai.cn
SNN_AI_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

QWEN_UPSTREAM_BASE_URL=http://127.0.0.1:8000/v1
QWEN_MODEL=
QWEN_UPSTREAM_API_KEY=

AI_STATUS_TIMEOUT_MS=4000
AI_CHAT_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=512
AI_MAX_BODY_BYTES=65536
AI_SYSTEM_PROMPT=你是 SNN AI，由 SNN 社团提供的 AI 助手。

# --- Internal Agent Core (Phase 2A-2F) ---
# Disabled by default. This listener is private and never shares the public AI Node port.
SNN_AGENT_INTERNAL_ENABLED=false
SNN_AGENT_INTERNAL_HOST=127.0.0.1
SNN_AGENT_INTERNAL_PORT=8788
SNN_AGENT_INTERNAL_MAX_BODY_BYTES=16384
SNN_AGENT_INTERNAL_MESSAGE_MAX_LENGTH=16384
# Set the following only when the internal agent feature is enabled. Do not commit real paths or credentials.
# SNN_AGENT_DSH_SDK_PATH=
# SNN_AGENT_DSH_TOOL_HOST_PATH=
# SNN_AGENT_WORKSPACE_ID=snn-workspace-default
# SNN_AGENT_SESSION_METADATA_ROOT=
# SNN_AGENT_DSH_RUNTIME_EXECUTABLE=
# SNN_AGENT_DSH_RUNTIME_ARGUMENTS=[]
# SNN_AGENT_DSH_CORDIS_CONFIG=
# SNN_AGENT_DSH_RUNTIME_CWD=
# SNN_AGENT_DSH_PROVIDER=
# SNN_AGENT_DSH_MODEL=
# SNN_AGENT_DSH_ENV_PASSTHROUGH=DEEPSEEK_API_KEY,DEEPSEEK_BASE_URL,DSH_SESSION_ROOT
# SNN_AGENT_DSH_ENV_REQUIRED=DEEPSEEK_API_KEY,DEEPSEEK_BASE_URL,DSH_SESSION_ROOT

# --- Public Agent BFF (Phase 3/4) ---
# Disabled by default. When enabled, the public AI Node serves /api/agent/* routes
# with HttpOnly cookie ownership, CORS, CSRF protection, and per-session Workspace isolation.
# Requires SNN_AGENT_INTERNAL_ENABLED=true (Agent core must be available).
# Production MUST set SNN_AGENT_PUBLIC_COOKIE_SECURE=true when serving over HTTPS.
# Production MUST set SNN_AI_ALLOWED_ORIGINS to include the real browser origin (e.g. https://snnai.cn).
SNN_AGENT_PUBLIC_ENABLED=false
SNN_AGENT_PUBLIC_COOKIE_SECURE=false
SNN_AGENT_PUBLIC_COOKIE_NAME=snn_agent_owner
SNN_AGENT_PUBLIC_SESSION_TTL_MS=86400000
SNN_AGENT_PUBLIC_MAX_SESSIONS_GLOBAL=100
SNN_AGENT_PUBLIC_MAX_SESSIONS_PER_OWNER=10
SNN_AGENT_PUBLIC_MAX_ACTIVE_RUNS_GLOBAL=20
SNN_AGENT_PUBLIC_MAX_ACTIVE_RUNS_PER_OWNER=3
SNN_AGENT_PUBLIC_MAX_WORKSPACES=100
# Required only when SNN_AGENT_PUBLIC_ENABLED=true:
# SNN_AGENT_PUBLIC_WORKSPACE_BASE=/var/snn-agent/workspaces
# SNN_AGENT_PUBLIC_OWNERSHIP_ROOT=/var/snn-agent/ownership
