{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snn-ai-gateway",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-17",
  "vars": {
    // TODO(上线前): 替换为真实 ai-origin 域名（docs/ai-host-setup.md 第 3 步创建的命名 Tunnel 域名）
    "AI_ORIGIN_URL": "https://ai-origin.example.com",
    // TODO(上线前): 替换为网站真实域名；保留 localhost 供本地开发调试
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:8765",
    "MAX_CHAT_BODY_BYTES": "65536",
    "AI_ORIGIN_TIMEOUT_MS": "45000"
  },
  "ratelimits": [
    {
      "name": "AI_CHAT_RATE_LIMIT",
      // TODO(上线前): 替换为 Cloudflare 后台创建的真实限流 namespace_id
      "namespace_id": "878701",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "AI_STATUS_RATE_LIMIT",
      // TODO(上线前): 替换为 Cloudflare 后台创建的真实限流 namespace_id
      "namespace_id": "878702",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
