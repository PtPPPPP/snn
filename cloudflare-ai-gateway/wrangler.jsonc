{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snn-ai-gateway",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-17",
  "vars": {
    "AI_ORIGIN_URL": "https://ai-origin.example.com",
    "ALLOWED_ORIGINS": "https://www.example.com,http://localhost:5173,http://127.0.0.1:8765",
    "MAX_CHAT_BODY_BYTES": "65536",
    "AI_ORIGIN_TIMEOUT_MS": "45000"
  },
  "ratelimits": [
    {
      "name": "AI_CHAT_RATE_LIMIT",
      "namespace_id": "878701",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "AI_STATUS_RATE_LIMIT",
      "namespace_id": "878702",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
