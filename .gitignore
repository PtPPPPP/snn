# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
/ftp-upload/
/.static-export-temp/
/.vinext/
*.tsbuildinfo

# local AI node data and model weights
/ai-node/.env
/ai-node/models/
/ai-node/data/
/ai-node/logs/
*.gguf

# Cloudflare Worker local secrets
/cloudflare-ai-gateway/.dev.vars

# WorkBuddy local workspace data (memory/logs)
/.workbuddy/
